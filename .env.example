SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+10000000000
# Alternatively, set TWILIO_MESSAGING_SERVICE_SID instead of TWILIO_FROM_NUMBER.
# Generate a unique random value of at least 32 bytes for this server-side key.
FIR_OTP_HMAC_SECRET=replace_with_at_least_32_random_bytes

# Local authentication gateway settings. Set FIR_AUTH_COOKIE_SECURE=true
# behind HTTPS; never expose the Streamlit or gateway ports directly.
FIR_AUTH_SESSION_TTL_SECONDS=43200
FIR_AUTH_COOKIE_SECURE=false
FIR_AUTH_TRUST_PROXY=true
FIR_AUTH_ALLOWED_HOSTS=localhost,127.0.0.1
FIR_AUTH_GATEWAY_HOST=127.0.0.1
FIR_AUTH_GATEWAY_PORT=8502
FIR_AUTH_GATEWAY_HEALTH_TIMEOUT_SECONDS=2
# Count complete public complaint-status lookups per trusted client IP.
FIR_PUBLIC_LOOKUP_RATE_LIMIT=10
FIR_PUBLIC_LOOKUP_RATE_WINDOW_SECONDS=900
# Keep false except for isolated local/demo databases.
FIR_ENABLE_DEMO_ACCOUNTS=false
